import { readFileSync, writeFileSync } from "node:fs";
import { g1, g2 } from "../lib/zk/encoding.ts";

/**
 * Writes programs/anuma/src/vk.rs: the Semaphore v4 verification key for one Merkle depth as a
 * groth16-solana 0.2 `Groth16Verifyingkey`. The source is @semaphore-protocol/proof
 * src/verification-keys.json, which stores shared alpha/beta/gamma and per-depth delta_2/IC arrays
 * (index = depth - 1). Uses the same G1/G2 byte layout as the browser proof encoder.
 * Usage: node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/vk-to-rust.mts [depth=16]
 */
const depth = Number(process.argv[2] ?? 16);
const source = new URL("../node_modules/@semaphore-protocol/proof/src/verification-keys.json", import.meta.url);
const target = new URL("../../../programs/anuma/src/vk.rs", import.meta.url);
const version = JSON.parse(readFileSync(new URL("../node_modules/@semaphore-protocol/proof/package.json", import.meta.url), "utf8")).version;
const all = JSON.parse(readFileSync(source, "utf8"));
const ic: string[][] = all.IC[depth - 1];

const rs = (bytes: Uint8Array) => `[${[...bytes].join(", ")}]`;
const out = `use groth16_solana::groth16::Groth16Verifyingkey;

/// Semaphore v4 verification key for Merkle depth ${depth}, from @semaphore-protocol/proof ${version}
/// verification-keys.json (vk_delta_2[${depth - 1}], IC[${depth - 1}]) in groth16-solana 0.2 byte layout. Generated by
/// apps/web/scripts/vk-to-rust.mts; regenerate instead of editing.
pub const VERIFYING_KEY: Groth16Verifyingkey = Groth16Verifyingkey {
    nr_pubinputs: ${ic.length - 1},
    vk_alpha_g1: ${rs(g1(all.vk_alpha_1))},
    vk_beta_g2: ${rs(g2(all.vk_beta_2))},
    vk_gamme_g2: ${rs(g2(all.vk_gamma_2))},
    vk_delta_g2: ${rs(g2(all.vk_delta_2[depth - 1]))},
    vk_ic: &[
${ic.map((p) => `        ${rs(g1(p))},`).join("\n")}
    ],
};
`;
writeFileSync(target, out);
console.log(`wrote programs/anuma/src/vk.rs (depth ${depth}, ${ic.length} IC points)`);
